@page
@model WorkTimeTracker.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="auth-page row justify-content-center align-items-center">
    <div class="auth-column col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
        <div class="auth-card card border-0 shadow-sm">
            <div class="auth-card-body card-body p-4 p-sm-5">
                <header class="auth-header text-center mb-4">
                    <div class="auth-brand mb-3">
                        <img src="~/images/rivbro-logo.png" class="auth-brand-logo" alt="RivBro" />
                    </div>
                    <h1 class="auth-title h4 mb-2">С возвращением</h1>
                    <p class="auth-subtitle text-muted mb-0">Войдите в систему учёта рабочего времени</p>
                </header>

                <form method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="auth-validation text-danger small mb-3" role="alert"></div>

                    <div class="auth-field form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                        <label asp-for="Input.Email"></label>
                        <span asp-validation-for="Input.Email" class="auth-field-validation text-danger small"></span>
                    </div>
                    <div class="auth-field form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="Пароль" />
                        <label asp-for="Input.Password"></label>
                        <span asp-validation-for="Input.Password" class="auth-field-validation text-danger small"></span>
                    </div>
                    <div class="auth-remember form-check mb-4">
                        <input asp-for="Input.RememberMe" class="form-check-input" />
                        <label asp-for="Input.RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="auth-submit btn btn-primary w-100 py-2">Войти</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
