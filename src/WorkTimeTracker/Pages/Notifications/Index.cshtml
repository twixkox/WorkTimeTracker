@page
@model WorkTimeTracker.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Уведомления";
}

<div class="page-heading">
    <div>
        <div class="page-eyebrow">Личный кабинет</div>
        <h4 class="mb-0">Центр уведомлений</h4>
    </div>
    <a class="btn btn-outline-secondary" asp-page="./Settings"><i class="bi bi-gear"></i> Настройки</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label asp-for="Filter" class="form-label">Состояние</label>
                <select asp-for="Filter" class="form-select">
                    <option value="unread">Непрочитанные</option>
                    <option value="all">Все</option>
                </select>
            </div>
            <div class="col-sm-5 col-md-4">
                <label asp-for="Category" class="form-label">Категория</label>
                <select asp-for="Category" class="form-select">
                    <option value="">Все категории</option>
                    <option value="@NotificationCategory.Timesheet">Табель</option>
                    <option value="@NotificationCategory.Engineering">Инженерные задачи</option>
                    <option value="@NotificationCategory.System">Система</option>
                </select>
            </div>
            <div class="col-sm-3 col-md-auto">
                <button class="btn btn-outline-primary" type="submit"><i class="bi bi-funnel"></i> Показать</button>
            </div>
        </form>
    </div>
</div>

@if (Model.UnreadCount > 0)
{
    <form method="post" asp-page-handler="MarkAllRead" class="d-flex justify-content-end mb-3">
        <input type="hidden" name="filter" value="@Model.Filter" />
        <input type="hidden" name="category" value="@Model.Category" />
        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
        <button class="btn btn-sm btn-outline-secondary" type="submit">
            <i class="bi bi-check2-all"></i> Отметить все прочитанными (@Model.UnreadCount)
        </button>
    </form>
}

<div class="card">
    @if (Model.Items.Count == 0)
    {
        <div class="empty-state"><i class="bi bi-bell-slash"></i><div>По выбранным фильтрам уведомлений нет</div></div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var notification in Model.Items)
            {
                <div class="list-group-item @(notification.IsRead ? "" : "list-group-item-primary")">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (string.IsNullOrWhiteSpace(notification.Link))
                                {
                                    <strong>@notification.Title</strong>
                                }
                                else
                                {
                                    <a class="text-reset" href="@notification.Link"><strong>@notification.Title</strong></a>
                                }
                                <span class="badge text-bg-secondary">@IndexModel.CategoryName(notification.Category)</span>
                            </div>
                            <div>@notification.Message</div>
                        </div>
                        <div class="text-end">
                            <small class="d-block text-muted mb-2">@notification.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                            @if (!notification.IsRead)
                            {
                                <form method="post" asp-page-handler="MarkRead">
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <input type="hidden" name="filter" value="@Model.Filter" />
                                    <input type="hidden" name="category" value="@Model.Category" />
                                    <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">
                                        <i class="bi bi-check2"></i> Прочитано
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Страницы уведомлений">
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-filter="@Model.Filter"
                   asp-route-category="@Model.Category" asp-route-pageNumber="@(Model.PageNumber - 1)">Назад</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.PageNumber из @Model.TotalPages</span></li>
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-page="./Index" asp-route-filter="@Model.Filter"
                   asp-route-category="@Model.Category" asp-route-pageNumber="@(Model.PageNumber + 1)">Вперёд</a>
            </li>
        </ul>
    </nav>
}
