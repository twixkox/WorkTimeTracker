@page
@model WorkTimeTracker.Pages.Engineering.IndexModel
@{
    ViewData["Title"] = "Конструкторское бюро";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h4 class="mb-1">Конструкторское бюро</h4>
        <div class="text-muted small">Задачи и сроки их выполнения</div>
    </div>
</div>

@if (Model.CanCreate)
{
    <div class="card mb-3">
        <div class="card-header"><strong>Новое задание</strong></div>
        <div class="card-body">
            <form method="post" asp-page-handler="Create" class="row g-2 align-items-end">
                <input type="hidden" name="filter" value="@Model.Filter" />
                <input type="hidden" name="search" value="@Model.Search" />
                <div class="col-lg-7">
                    <label asp-for="Title" class="form-label">Задача</label>
                    <input asp-for="Title" class="form-control" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="col-md-6 col-lg-3">
                    <label asp-for="HullNumber" class="form-label">№ корпуса <span class="text-muted fw-normal">(необязательно)</span></label>
                    <input asp-for="HullNumber" class="form-control" />
                    <span asp-validation-for="HullNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6 col-lg-2 d-grid">
                    <button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Создать</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-sm-5 col-lg-3">
                <select name="filter" class="form-select form-select-sm" aria-label="Фильтр по статусу">
                    <option value="active" selected="@(Model.Filter == "active")">В работе</option>
                    <option value="completed" selected="@(Model.Filter == "completed")">Завершённые</option>
                    <option value="all" selected="@(Model.Filter == "all")">Все</option>
                </select>
            </div>
            <div class="col-sm-7 col-lg-5">
                <input type="search" name="search" value="@Model.Search" class="form-control form-control-sm"
                       placeholder="Поиск по задаче, корпусу, автору или исполнителю" aria-label="Поиск" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-primary">Показать</button>
            </div>
            @if (Model.Filter != "active" || Model.Search is not null)
            {
                <div class="col-auto">
                    <a asp-page="./Index" class="btn btn-sm btn-outline-secondary">Сбросить</a>
                </div>
            }
        </form>
    </div>
</div>

@if (!Model.Tasks.Any())
{
    <div class="alert alert-light border text-center py-5 mb-0">
        <i class="bi bi-clipboard2 fs-3 d-block mb-2 text-muted"></i>
        <strong>Задачи не найдены</strong>
        <div class="text-muted small mt-1">
            @(Model.Search is not null ? "Измените условия поиска или сбросьте фильтры." : "В выбранном разделе пока нет задач.")
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-nowrap">Поставлено</th>
                        <th style="min-width: 10rem;">Автор задачи</th>
                        <th style="min-width: 18rem;">Задача</th>
                        <th style="min-width: 11rem;">Исполнитель</th>
                        <th class="text-nowrap">Взято в работу</th>
                        <th class="text-nowrap">План. срок</th>
                        <th class="text-nowrap">Готово</th>
                        <th class="text-nowrap">Дедлайн</th>
                        <th class="text-nowrap">Введено с № корпуса</th>
                        <th>Статус</th>
                        @if (Model.CanEdit) { <th></th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in Model.Tasks)
                    {
                        var overdue = Model.IsOverdue(task);
                        <tr>
                            <td class="text-nowrap">@task.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>@task.CreatedByName</td>
                            <td>@task.Title</td>
                            <td>
                                @if (task.Assignee is not null)
                                {
                                    @(string.IsNullOrWhiteSpace(task.Assignee.DisplayName) ? task.Assignee.Email : task.Assignee.DisplayName)
                                }
                                else
                                {
                                    <span class="text-muted">Не назначен</span>
                                }
                            </td>
                            <td class="text-nowrap">@(task.StartedOn?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td class="text-nowrap">@(task.PlannedDueOn?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td class="text-nowrap">@(task.CompletedOn?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td class="text-nowrap @(overdue ? "table-danger" : "")">
                                @(task.Deadline?.ToString("dd.MM.yyyy") ?? "—")
                                @if (overdue)
                                {
                                    <span class="badge text-bg-danger ms-1">Просрочено</span>
                                }
                            </td>
                            <td>@(task.HullNumber ?? "—")</td>
                            <td><span class="badge @Model.StatusClass(task)">@Model.Status(task)</span></td>
                            @if (Model.CanEdit)
                            {
                                <td class="text-end text-nowrap">
                                    <a asp-page="./Edit" asp-route-id="@task.Id" class="btn btn-sm btn-outline-primary">Изменить</a>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
