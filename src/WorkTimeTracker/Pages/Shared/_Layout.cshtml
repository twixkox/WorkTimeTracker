@inject WorkTimeTracker.Services.CurrentUserService CurrentUser
@inject WorkTimeTracker.Services.NotificationService NotificationService
@{
    var user = CurrentUser.User;
    var employee = user?.Identity?.IsAuthenticated == true ? await CurrentUser.GetEmployeeAsync() : null;
    var unread = 0;
    if (user?.Identity?.IsAuthenticated == true && CurrentUser.UserId is not null)
        unread = await NotificationService.GetUnreadCountAsync(CurrentUser.UserId);
    string? userRole = user switch
    {
        null => null,
        _ when user.IsInRole(AppRoles.Admin) => AppRoles.Admin,
        _ when user.IsInRole(AppRoles.ChiefEngineer) => AppRoles.ChiefEngineer,
        _ when user.IsInRole(AppRoles.Engineer) => AppRoles.Engineer,
        _ when user.IsInRole(AppRoles.ProductionHead) => AppRoles.ProductionHead,
        _ when user.IsInRole(AppRoles.SectionMaster) => AppRoles.SectionMaster,
        _ when user.IsInRole(AppRoles.Employee) => AppRoles.Employee,
        _ => null,
    };
    string? HomeUrl() => user switch
    {
        null => null,
        _ when user.IsInRole(AppRoles.Admin) => "/Admin/Index",
        _ when user.IsInRole(AppRoles.ChiefEngineer) || user.IsInRole(AppRoles.Engineer) => "/Engineering/Index",
        _ when user.IsInRole(AppRoles.ProductionHead) => "/Production/Dashboard",
        _ when user.IsInRole(AppRoles.SectionMaster) => "/Master/Index",
        _ => "/Employee/Index",
    };
    bool IsActive(string path) => string.Equals(Context.Request.Path.Value, path, StringComparison.OrdinalIgnoreCase);
    string NavLinkClass(string path) => IsActive(path) ? "nav-link app-nav-link active" : "nav-link app-nav-link";
    string? AriaCurrent(string path) => IsActive(path) ? "page" : null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is null ? "Учёт рабочего времени" : ViewData["Title"] + " — Учёт рабочего времени")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <a class="app-skip-link visually-hidden-focusable" href="#main-content">Перейти к основному содержимому</a>

    <header class="app-header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar" aria-label="Основная навигация">
            <div class="container-xl">
                <a class="navbar-brand app-brand" href="@(HomeUrl() ?? "/Index")" title="Учёт рабочего времени" aria-label="Учёт рабочего времени — на главную">
                    <img src="~/images/rivbro-logo.png" alt="River Brothers" class="brand-logo" />
                </a>

                @if (user?.Identity?.IsAuthenticated == true)
                {
                    <div class="app-navbar-actions d-flex align-items-center order-lg-2">
                        <a class="nav-link app-notification-link position-relative @(IsActive("/Notifications/Index") ? "active" : null)"
                           href="/Notifications/Index"
                           title="Уведомления"
                           aria-label="@(unread > 0 ? $"Уведомления, непрочитанных: {unread}" : "Уведомления")"
                           aria-current="@AriaCurrent("/Notifications/Index")">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            @if (unread > 0)
                            {
                                <span class="app-notification-badge position-absolute top-25 start-75 translate-middle badge rounded-pill bg-danger" aria-hidden="true">@unread</span>
                            }
                        </a>
                        <button class="navbar-toggler ms-2" type="button"
                                data-bs-toggle="collapse" data-bs-target="#nav"
                                aria-controls="nav" aria-expanded="false" aria-label="Открыть меню навигации">
                            <span class="navbar-toggler-icon" aria-hidden="true"></span>
                        </button>
                    </div>
                }

                <div class="collapse navbar-collapse app-navbar-collapse order-lg-1" id="nav">
                    @if (user?.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav app-primary-nav me-auto">
                            @if ((user.IsInRole(AppRoles.Employee) || user.IsInRole(AppRoles.SectionMaster)) && !user.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item app-nav-item">
                                    <a class="@NavLinkClass("/Employee/Index")" href="/Employee/Index" aria-current="@AriaCurrent("/Employee/Index")">
                                        <i class="bi bi-calendar2-check app-nav-icon me-2" aria-hidden="true"></i>Мой табель
                                    </a>
                                </li>
                                <li class="nav-item app-nav-item">
                                    <a class="@NavLinkClass("/Employee/History")" href="/Employee/History" aria-current="@AriaCurrent("/Employee/History")">
                                        <i class="bi bi-clock-history app-nav-icon me-2" aria-hidden="true"></i>История
                                    </a>
                                </li>
                            }
                            @if (user.IsInRole(AppRoles.SectionMaster))
                            {
                                <li class="nav-item app-nav-item">
                                    <a class="@NavLinkClass("/Master/Index")" href="/Master/Index" aria-current="@AriaCurrent("/Master/Index")">
                                        <i class="bi bi-clipboard2-check app-nav-icon me-2" aria-hidden="true"></i>Табели участка
                                    </a>
                                </li>
                                <li class="nav-item app-nav-item">
                                    <a class="@NavLinkClass("/Master/Summary")" href="/Master/Summary" aria-current="@AriaCurrent("/Master/Summary")">
                                        <i class="bi bi-bar-chart app-nav-icon me-2" aria-hidden="true"></i>Сводка
                                    </a>
                                </li>
                            }
                            @if (user.IsInRole(AppRoles.ProductionHead) || user.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item app-nav-item">
                                    <a class="@NavLinkClass("/Production/Index")" href="/Production/Index" aria-current="@AriaCurrent("/Production/Index")">
                                        <i class="bi bi-table app-nav-icon me-2" aria-hidden="true"></i>Табели
                                    </a>
                                </li>
                            }
                            @if (user.IsInRole(AppRoles.ProductionHead))
                            {
                                <li class="nav-item app-nav-item">
                                    <a class="@NavLinkClass("/Production/Dashboard")" href="/Production/Dashboard" aria-current="@AriaCurrent("/Production/Dashboard")">
                                        <i class="bi bi-speedometer2 app-nav-icon me-2" aria-hidden="true"></i>Дашборд
                                    </a>
                                </li>
                            }
                            @if (user.IsInRole(AppRoles.ChiefEngineer) || user.IsInRole(AppRoles.Engineer) || user.IsInRole(AppRoles.ProductionHead) || user.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item app-nav-item">
                                    <a class="@NavLinkClass("/Engineering/Index")" href="/Engineering/Index" aria-current="@AriaCurrent("/Engineering/Index")">
                                        <i class="bi bi-gear-wide-connected app-nav-icon me-2" aria-hidden="true"></i>Задачи КБ
                                    </a>
                                </li>
                            }
                            @if (user.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item app-nav-item">
                                    <a class="@NavLinkClass("/Admin/Index")" href="/Admin/Index" aria-current="@AriaCurrent("/Admin/Index")">
                                        <i class="bi bi-shield-lock app-nav-icon me-2" aria-hidden="true"></i>Администрирование
                                    </a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav app-user-nav">
                            <li class="nav-item dropdown app-profile-dropdown">
                                <a class="nav-link dropdown-toggle app-profile-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle app-profile-avatar" aria-hidden="true"></i>
                                    <span class="app-profile-copy">
                                        <span class="app-profile-name">@(employee?.FullName ?? user.Identity!.Name)</span>
                                        <span class="app-profile-role">@(userRole is null ? "Роль не назначена" : RoleName.ToRussian(userRole))</span>
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end app-dropdown-menu" aria-label="Действия пользователя">
                                    <li><a class="dropdown-item" href="/Identity/Account/Manage"><i class="bi bi-key me-2" aria-hidden="true"></i>Смена пароля</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Identity/Account/Login" class="app-logout-form px-3 py-1">
                                            <button class="btn btn-sm btn-outline-danger w-100" type="submit"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Выйти</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="app-main container-xl py-4" tabindex="-1">
        @if (TempData["Success"] is string ok)
        {
            <div class="app-alert alert alert-success alert-dismissible fade show" role="status"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>@ok<button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Закрыть"></button></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="app-alert alert alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-circle me-1" aria-hidden="true"></i>@err<button class="btn-close" type="button" data-bs-dismiss="alert" aria-label="Закрыть"></button></div>
        }
        @RenderBody()
    </main>

    <footer class="app-footer text-center text-muted small py-3 border-top">
        <div class="container-xl">© @DateTime.Now.Year · Учёт рабочего времени</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
