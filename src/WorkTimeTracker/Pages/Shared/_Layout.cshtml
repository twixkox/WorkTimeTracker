@inject WorkTimeTracker.Services.CurrentUserService CurrentUser
@inject WorkTimeTracker.Services.NotificationService NotificationService
@{
    var user = CurrentUser.User;
    var employee = user?.Identity?.IsAuthenticated == true ? await CurrentUser.GetEmployeeAsync() : null;
    var unread = 0;
    if (user?.Identity?.IsAuthenticated == true && CurrentUser.UserId is not null)
        unread = await NotificationService.GetUnreadCountAsync(CurrentUser.UserId);
    string? HomeUrl() => user switch
    {
        null => null,
        _ when user.IsInRole(AppRoles.Admin) => "/Admin/Index",
        _ when user.IsInRole(AppRoles.ProductionHead) => "/Production/Dashboard",
        _ when user.IsInRole(AppRoles.SectionMaster) => "/Master/Index",
        _ => "/Employee/Index",
    };
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is null ? "Учёт рабочего времени" : ViewData["Title"] + " — Учёт рабочего времени")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top">
        <div class="container">
            <a class="navbar-brand fw-semibold" href="@(HomeUrl() ?? "/Index")">
                <i class="bi bi-clock-history"></i> Учёт рабочего времени
            </a>
            <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                @if (user?.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto">
                        @if (user.IsInRole(AppRoles.Employee) && !user.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Employee/Index">Мой табель</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Employee/History">История</a></li>
                        }
                        @if (user.IsInRole(AppRoles.SectionMaster))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Master/Index">Табели участка</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Master/Summary">Сводка</a></li>
                        }
                        @if (user.IsInRole(AppRoles.ProductionHead))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Production/Index">Табели</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Production/Dashboard">Дашборд</a></li>
                        }
                        @if (user.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" href="/Admin/Index">Администрирование</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (unread > 0)
                        {
                            <li class="nav-item">
                                <a class="nav-link position-relative" href="/Employee/History" title="Уведомления">
                                    <i class="bi bi-bell-fill"></i>
                                    <span class="position-absolute top-25 start-75 translate-middle badge rounded-pill bg-danger" style="font-size:.6rem;">@unread</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> @(employee?.FullName ?? user.Identity!.Name)
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Identity/Account/Manage">Профиль</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form method="post" action="/Identity/Account/Logout" class="px-3">
                                        <button class="btn btn-sm btn-outline-danger w-100">Выйти</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                }
            </div>
        </div>
    </nav>

    <main class="container py-3">
        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success alert-dismissible fade show">@ok<button class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger alert-dismissible fade show">@err<button class="btn-close" data-bs-dismiss="alert"></button></div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-3 border-top">
        Учёт рабочего времени · Сбор · Столяр · Швейка · 15
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
