@model WorkTimeTracker.Pages.Employee.DayFormPartialModel
@{
    var day = Model.Day;
    var entries = day.Entries.Count > 0 ? day.Entries : new List<WorkTimeTracker.Pages.Employee.EntryInput> { new() };
    var boats = Model.Boats;
    var workTypes = Model.WorkTypes;
}
<div class="day-form" data-date="@day.Date">
    <input type="hidden" name="Input.Date" value="@day.Date:yyyy-MM-dd" />
    <input type="hidden" name="Input.ReturnUrl" value="@day.ReturnUrl" />

    <div class="row g-2 align-items-end mb-2">
        <div class="col-auto">
            <label class="form-label mb-0 small">Начало рабочего дня</label>
            <input type="time" name="Input.StartTime" value="@day.StartTime:HH\\:mm" class="form-control form-control-sm day-start"
                   @(Model.CanEdit ? "" : "disabled") />
        </div>
        <div class="col-auto">
            <label class="form-label mb-0 small">Окончание рабочего дня</label>
            <input type="time" name="Input.EndTime" value="@day.EndTime:HH\\:mm" class="form-control form-control-sm day-end"
                   @(Model.CanEdit ? "" : "disabled") />
        </div>
        <div class="col-auto">
            <label class="form-label mb-0 small">Отработано</label>
            <div class="form-control-sm px-0"><span class="worked-hours fw-semibold">0</span> ч</div>
        </div>
        <div class="col-auto ms-auto text-end">
            <label class="form-label mb-0 small">Сумма затрат</label>
            <div class="form-control-sm px-0"><span class="entries-hours-sum fw-semibold">0</span> ч</div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm align-middle entries-table mb-1">
            <thead class="table-light">
                <tr>
                    <th style="width:9rem;">№ катера</th>
                    <th style="width:7rem;">Время затрат, ч</th>
                    <th>Выполненные работы</th>
                    <th style="width:9rem;">Внутрицеховые</th>
                    <th style="width:2.5rem;"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < entries.Count; i++)
                {
                    var e = entries[i];
                    <tr class="entries-row">
                        <td>
                            <select name="Input.Entries[@i].BoatId" class="form-select form-select-sm boat-select"
                                    disabled="@(Model.CanEdit ? null : "disabled")">
                                <option value="">— выберите —</option>
                                @foreach (var b in boats)
                                {
                                    <option value="@b.Id" selected="@(e.BoatId == b.Id)">@b.Number@(string.IsNullOrEmpty(b.Name) ? "" : $" · {b.Name}")</option>
                                }
                            </select>
                        </td>
                        <td>
                            <input name="Input.Entries[@i].Hours" value="@(e.Hours?.ToString("0.##"))"
                                   class="form-control form-control-sm hours-input" inputmode="decimal" placeholder="0,0"
                                   disabled="@(Model.CanEdit ? null : "disabled")" />
                        </td>
                        <td>
                            <input name="Input.Entries[@i].WorkDescription" value="@e.WorkDescription" list="worktypes-@day.Date"
                                   class="form-control form-control-sm" placeholder="Выполненные работы"
                                   disabled="@(Model.CanEdit ? null : "disabled")" />
                        </td>
                        <td class="text-center">
                            <input type="checkbox" name="Input.Entries[@i].IsInhouse" value="true" class="form-check-input inhouse-check"
                                   checked="@(e.IsInhouse ? "checked" : null)"
                                   disabled="@(Model.CanEdit ? null : "disabled")" />
                        </td>
                        <td>
                            @if (Model.CanEdit)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger border-0 remove-row" title="Удалить строку">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <datalist id="worktypes-@day.Date">
        @foreach (var wt in workTypes)
        {
            <option value="@wt.Name"></option>
        }
    </datalist>

    @if (Model.CanEdit)
    {
        <button type="button" class="btn btn-sm btn-outline-primary add-row">
            <i class="bi bi-plus-lg"></i> Добавить запись
        </button>
    }

    <template class="row-template">
        <tr class="entries-row">
            <td>
                <select name="Input.Entries[__i__].BoatId" class="form-select form-select-sm boat-select">
                    <option value="">— выберите —</option>
                    @foreach (var b in boats)
                    {
                        <option value="@b.Id">@b.Number@(string.IsNullOrEmpty(b.Name) ? "" : $" · {b.Name}")</option>
                    }
                </select>
            </td>
            <td>
                <input name="Input.Entries[__i__].Hours" class="form-control form-control-sm hours-input" inputmode="decimal" placeholder="0,0" />
            </td>
            <td>
                <input name="Input.Entries[__i__].WorkDescription" list="worktypes-@day.Date" class="form-control form-control-sm" placeholder="Выполненные работы" />
            </td>
            <td class="text-center">
                <input type="checkbox" name="Input.Entries[__i__].IsInhouse" value="true" class="form-check-input inhouse-check" />
            </td>
            <td>
                <button type="button" class="btn btn-sm btn-outline-danger border-0 remove-row" title="Удалить строку">
                    <i class="bi bi-x-lg"></i>
                </button>
            </td>
        </tr>
    </template>

    @if (Model.ShowActions && Model.CanEdit)
    {
        <div class="d-flex gap-2 mt-3 no-print">
            <button type="submit" formaction="?handler=Save" class="btn btn-outline-secondary">
                <i class="bi bi-save"></i> Сохранить черновик
            </button>
            <button type="submit" formaction="?handler=Submit" class="btn btn-primary">
                <i class="bi bi-send"></i> Отправить на утверждение
            </button>
        </div>
    }
</div>
