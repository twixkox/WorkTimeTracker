@page
@model WorkTimeTracker.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Администрирование";
}

<h4 class="mb-3">Администрирование</h4>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2">
        <div class="text-muted small">Сотрудники</div><div class="fs-4 fw-semibold">@Model.EmployeesCount</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2">
        <div class="text-muted small">Пользователи</div><div class="fs-4 fw-semibold">@Model.UsersCount</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2">
        <div class="text-muted small">Катера</div><div class="fs-4 fw-semibold">@Model.BoatsCount</div></div></div></div>
    <div class="col-6 col-md-3"><div class="card"><div class="card-body py-2">
        <div class="text-muted small">На утверждении</div><div class="fs-4 fw-semibold">@Model.PendingApproval</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header"><strong>Справочники</strong></div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action" href="/Admin/Departments"><i class="bi bi-diagram-3"></i> Подразделения <span class="badge bg-secondary">@Model.DepartmentsCount</span></a>
                <a class="list-group-item list-group-item-action" href="/Admin/Employees"><i class="bi bi-people"></i> Сотрудники</a>
                <a class="list-group-item list-group-item-action" href="/Admin/Boats"><i class="bi bi-water"></i> Катера</a>
                <a class="list-group-item list-group-item-action" href="/Admin/WorkTypes"><i class="bi bi-list-task"></i> Виды работ</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header"><strong>Пользователи и доступ</strong></div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action" href="/Admin/Users"><i class="bi bi-person-badge"></i> Пользователи и роли</a>
                <a class="list-group-item list-group-item-action" href="/Identity/Account/Register"><i class="bi bi-person-plus"></i> Создать пользователя</a>
                <a class="list-group-item list-group-item-action" href="/Admin/Audit"><i class="bi bi-journal-text"></i> Журнал аудита <span class="badge bg-secondary">@Model.AuditCount</span></a>
                <a class="list-group-item list-group-item-action" href="/Admin/Settings"><i class="bi bi-gear"></i> Настройки системы</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header"><strong>Отчёты и данные</strong></div>
            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action" href="/Admin/Reports"><i class="bi bi-file-earmark-spreadsheet"></i> Отчёты в Excel</a>
                <a class="list-group-item list-group-item-action" href="/Admin/Import"><i class="bi bi-upload"></i> Импорт из Excel</a>
            </div>
        </div>
    </div>
</div>
