@page
@model WorkTimeTracker.Pages.Admin.ImportModel
@{
    ViewData["Title"] = "Импорт из Excel";
}

<h4 class="mb-3">Импорт из Excel (миграция данных)</h4>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><strong>Катера</strong></div>
            <div class="card-body">
                <p class="small text-muted">Формат файла: первая строка — заголовки, затем колонки <code>№ катера | Название | Заказчик</code>.</p>
                <form method="post" asp-page-handler="Boats" enctype="multipart/form-data">
                    <input type="file" name="file" accept=".xlsx" class="form-control mb-2" required />
                    <button class="btn btn-primary"><i class="bi bi-upload"></i> Импортировать катера</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header"><strong>Сотрудники</strong></div>
            <div class="card-body">
                <p class="small text-muted">Формат файла: первая строка — заголовки, затем колонки <code>ФИО | Подразделение | Должность</code>. Отсутствующие подразделения будут созданы.</p>
                <form method="post" asp-page-handler="Employees" enctype="multipart/form-data">
                    <input type="file" name="file" accept=".xlsx" class="form-control mb-2" required />
                    <button class="btn btn-primary"><i class="bi bi-upload"></i> Импортировать сотрудников</button>
                </form>
            </div>
        </div>
    </div>
</div>
