@page
@model WorkTimeTracker.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Журнал аудита";
}

<h4 class="mb-3">Журнал аудита</h4>

<form method="get" class="d-flex gap-2 mb-3">
    <input name="user" value="@Model.FilterUser" class="form-control form-control-sm" style="max-width:14rem;" placeholder="Пользователь" />
    <input name="entity" value="@Model.FilterEntity" class="form-control form-control-sm" style="max-width:14rem;" placeholder="Сущность (WorkDay, Boat...)" />
    <button class="btn btn-sm btn-primary">Фильтр</button>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm mb-0">
            <thead class="table-light">
                <tr><th>Время</th><th>Пользователь</th><th>Действие</th><th>Сущность</th><th>ID</th><th>Детали</th></tr>
            </thead>
            <tbody>
                @foreach (var l in Model.Logs)
                {
                    <tr>
                        <td class="text-nowrap">@l.Timestamp.ToString("dd.MM.yyyy HH:mm:ss")</td>
                        <td>@l.UserName</td>
                        <td><span class="badge bg-secondary-subtle text-secondary-emphasis">@l.Action</span></td>
                        <td>@l.EntityName</td>
                        <td>@l.EntityId</td>
                        <td class="small">@l.Details</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm">
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" href="?p=@i&user=@Model.FilterUser&entity=@Model.FilterEntity">@i</a>
                </li>
            }
        </ul>
    </nav>
}
