@page
@model WorkTimeTracker.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Настройки системы";
}

<h4 class="mb-3">Настройки системы</h4>

<div class="card" style="max-width: 40rem;">
    <div class="card-body">
        <form method="post">
            <h6>Валидация</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Максимум часов в день</label>
                    <input asp-for="MaxHoursPerDay" class="form-control" type="number" step="0.5" min="1" max="24" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Порог переработки, ч</label>
                    <input asp-for="OvertimeThreshold" class="form-control" type="number" step="0.5" min="1" max="24" />
                </div>
            </div>

            <h6>Шаблон смены</h6>
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Начало по умолчанию</label>
                    <input asp-for="ShiftStart" class="form-control" type="time" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Окончание по умолчанию</label>
                    <input asp-for="ShiftEnd" class="form-control" type="time" />
                </div>
            </div>

            <h6>Дополнительные проверки</h6>
            <div class="form-check mb-3">
                <input asp-for="CheckIntervalOverlap" class="form-check-input" />
                <label class="form-check-label">Проверка пересечения временных интервалов</label>
            </div>

            <button class="btn btn-primary"><i class="bi bi-save"></i> Сохранить</button>
        </form>
    </div>
</div>
