@page
@model WorkTimeTracker.Pages.Admin.BoatsModel
@{
    ViewData["Title"] = "Катера";
    var edit = Model.EditId is int id ? Model.Boats.FirstOrDefault(b => b.Id == id) : null;
}

<h4 class="mb-3">Катера</h4>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><strong>@(edit is null ? "Новый катер" : "Редактирование")</strong></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Save">
                    @if (edit is not null) { <input type="hidden" name="EditId" value="@edit.Id" /> }
                    <div class="mb-2">
                        <label class="form-label">Номер</label>
                        <input name="Number" class="form-control" value="@(edit?.Number ?? Model.Number)" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Название</label>
                        <input name="Name" class="form-control" value="@(edit?.Name ?? Model.Name)" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Заказчик</label>
                        <input name="Customer" class="form-control" value="@(edit?.Customer ?? Model.Customer)" />
                    </div>
                    <button class="btn btn-primary">Сохранить</button>
                    @if (edit is not null) { <a class="btn btn-outline-secondary" href="/Admin/Boats">Отмена</a> }
                </form>
            </div>
        </div>
        <div class="alert alert-info small mt-3">
            Массовая загрузка — на странице <a href="/Admin/Import">Импорт из Excel</a>.
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Номер</th><th>Название</th><th>Заказчик</th><th>Активен</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.Boats)
                        {
                            <tr class="@(b.IsActive ? "" : "table-secondary")">
                                <td>@b.Number</td>
                                <td>@b.Name</td>
                                <td>@b.Customer</td>
                                <td>@(b.IsActive ? "да" : "нет")</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" href="?EditId=@b.Id">Изменить</a>
                                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                                        <input type="hidden" name="id" value="@b.Id" />
                                        <button class="btn btn-sm btn-outline-@(b.IsActive ? "danger" : "success")">
                                            @(b.IsActive ? "Деактивировать" : "Активировать")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
