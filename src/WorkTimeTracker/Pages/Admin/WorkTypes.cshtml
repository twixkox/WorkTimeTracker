@page
@model WorkTimeTracker.Pages.Admin.WorkTypesModel
@{
    ViewData["Title"] = "Виды работ";
}

<h4 class="mb-3">Виды работ</h4>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><strong>Новый вид работ</strong></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Add">
                    <div class="input-group">
                        <input name="Name" class="form-control" placeholder="Название" required />
                        <button class="btn btn-primary">Добавить</button>
                    </div>
                </form>
                <div class="small text-muted mt-2">Используются как подсказки в поле «Выполненные работы».</div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <ul class="list-group list-group-flush">
                @foreach (var w in Model.WorkTypes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @w.Name
                        <form method="post" asp-page-handler="Delete">
                            <input type="hidden" name="id" value="@w.Id" />
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
