@page
@model WorkTimeTracker.Pages.Admin.DepartmentsModel
@{
    ViewData["Title"] = "Подразделения";
    var edit = Model.EditId is int id ? Model.Departments.FirstOrDefault(d => d.Id == id) : null;
}

<h4 class="mb-3">Подразделения</h4>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><strong>@(edit is null ? "Новое подразделение" : "Редактирование")</strong></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Save">
                    @if (edit is not null)
                    {
                        <input type="hidden" name="EditId" value="@edit.Id" />
                    }
                    <div class="mb-2">
                        <label class="form-label">Название</label>
                        <input name="Name" class="form-control" value="@(edit?.Name ?? Model.Name)" required />
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" name="IsTimeOnly" value="true" class="form-check-input" id="time-only" checked="@(edit?.IsTimeOnly == true || Model.IsTimeOnly)" />
                        <label class="form-check-label" for="time-only">Только время, без затрат и утверждения</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" name="IsWeeklyView" value="true" class="form-check-input" id="weekly-view" checked="@(edit?.IsWeeklyView == true || Model.IsWeeklyView)" />
                        <label class="form-check-label" for="weekly-view">Недельный вид табеля</label>
                    </div>
                    <button class="btn btn-primary">Сохранить</button>
                    @if (edit is not null)
                    {
                        <a class="btn btn-outline-secondary" href="/Admin/Departments">Отмена</a>
                    }
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Название</th><th>Вид табеля</th><th>Активно</th><th>Сотрудников</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Departments)
                        {
                            <tr class="@(d.IsActive ? "" : "table-secondary")">
                                <td>@d.Name</td>
                                <td>@(d.IsTimeOnly ? "Только время" : d.IsWeeklyView ? "Недельный" : "По дням")</td>
                                <td>@(d.IsActive ? "да" : "нет")</td>
                                <td>@d.Employees.Count(e => e.IsActive)</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" href="?EditId=@d.Id">Изменить</a>
                                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button class="btn btn-sm btn-outline-@(d.IsActive ? "danger" : "success")">
                                            @(d.IsActive ? "Деактивировать" : "Активировать")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
