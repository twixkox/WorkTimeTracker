@page
@model WorkTimeTracker.Pages.Admin.DepartmentsModel
@{
    ViewData["Title"] = "Подразделения";
    var edit = Model.EditId is int id ? Model.Departments.FirstOrDefault(d => d.Id == id) : null;
}

<h4 class="mb-3">Подразделения</h4>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header"><strong>@(edit is null ? "Новое подразделение" : "Редактирование")</strong></div>
            <div class="card-body">
                <form method="post" asp-page-handler="Save">
                    @if (edit is not null)
                    {
                        <input type="hidden" name="EditId" value="@edit.Id" />
                    }
                    <div class="mb-2">
                        <label class="form-label">Название</label>
                        <input name="Name" class="form-control" value="@(edit?.Name ?? Model.Name)" required />
                    </div>
                    <div class="form-check form-switch mb-2">
                        <input type="checkbox" name="IsTimeOnly" value="true" class="form-check-input" id="time-only" checked="@(edit?.IsTimeOnly == true || Model.IsTimeOnly)" />
                        <label class="form-check-label" for="time-only">Только время, без затрат и утверждения</label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" name="IsWeeklyView" value="true" class="form-check-input" id="weekly-view" checked="@(edit?.IsWeeklyView == true || Model.IsWeeklyView)" />
                        <label class="form-check-label" for="weekly-view">Недельный вид табеля</label>
                    </div>
                    <button class="btn btn-primary">Сохранить</button>
                    @if (edit is not null)
                    {
                        <a class="btn btn-outline-secondary" href="/Admin/Departments">Отмена</a>
                    }
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr><th>Название</th><th>Вид табеля</th><th>Активно</th><th>Сотрудников</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model.Departments)
                        {
                            <tr class="@(d.IsActive ? "" : "table-secondary")">
                                <td>@d.Name</td>
                                <td>@(d.IsTimeOnly ? "Только время" : d.IsWeeklyView ? "Недельный" : "По дням")</td>
                                <td>@(d.IsActive ? "да" : "нет")</td>
                                <td>@d.Employees.Count(e => e.IsActive)</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" href="?DepartmentId=@d.Id#employees"><i class="bi bi-people"></i> Работники</a>
                                    <a class="btn btn-sm btn-outline-primary" href="?EditId=@d.Id">Изменить</a>
                                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button class="btn btn-sm btn-outline-@(d.IsActive ? "danger" : "success")">
                                            @(d.IsActive ? "Деактивировать" : "Активировать")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@if (Model.SelectedDepartment is { } selected)
{
    <div class="card mt-4" id="employees">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>Работники подразделения «@selected.Name»</strong>
            <span class="badge bg-secondary">@selected.Employees.Count(e => e.IsActive) активных</span>
        </div>
        <div class="card-body border-bottom">
            <form method="post" asp-page-handler="AddEmployee" class="row g-2 align-items-end">
                <input type="hidden" name="DepartmentId" value="@selected.Id" />
                <div class="col-md-5">
                    <label class="form-label" for="employee-name">ФИО работника</label>
                    <input class="form-control" id="employee-name" name="EmployeeFullName" value="@Model.EmployeeFullName" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="employee-position">Должность</label>
                    <input class="form-control" id="employee-position" name="EmployeePosition" value="@Model.EmployeePosition" />
                </div>
                <div class="col-md-3 d-grid">
                    <button class="btn btn-primary"><i class="bi bi-person-plus"></i> Добавить</button>
                </div>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>ФИО</th><th>Должность</th><th>Учётная запись</th><th>Статус</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var employee in selected.Employees)
                    {
                        <tr class="@(employee.IsActive ? "" : "table-secondary")">
                            <td>@employee.FullName</td>
                            <td>@(employee.Position ?? "—")</td>
                            <td>@(employee.UserId is null ? "Не привязана" : "Привязана")</td>
                            <td>@(employee.IsActive ? "Активен" : "Неактивен")</td>
                            <td class="text-end text-nowrap">
                                <form method="post" asp-page-handler="ToggleEmployee" class="d-inline">
                                    <input type="hidden" name="id" value="@employee.Id" />
                                    <input type="hidden" name="departmentId" value="@selected.Id" />
                                    <button class="btn btn-sm btn-outline-secondary">@(employee.IsActive ? "Деактивировать" : "Активировать")</button>
                                </form>
                                <form method="post" asp-page-handler="DeleteEmployee" class="d-inline" onsubmit="return confirm('Удалить работника? Это действие нельзя отменить.');">
                                    <input type="hidden" name="id" value="@employee.Id" />
                                    <input type="hidden" name="departmentId" value="@selected.Id" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!selected.Employees.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">В подразделении пока нет работников.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">
            Удалить можно только работника без табелей и привязанной учётной записи. В остальных случаях используйте деактивацию.
        </div>
    </div>
}
else
{
    <div class="alert alert-light border mt-4 mb-0">Нажмите «Работники» у подразделения, чтобы просмотреть и изменить его состав.</div>
}
