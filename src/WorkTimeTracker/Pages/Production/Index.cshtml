@page
@model WorkTimeTracker.Pages.Production.IndexModel
@using WorkTimeTracker.Models
@{
    ViewData["Title"] = "Табели всех участков";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
    <h4 class="mb-0">Табели всех участков</h4>
    <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <span>—</span>
        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <button class="btn btn-sm btn-primary">Показать</button>
    </form>
</div>
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm btn-outline-secondary" href="?from=@Model.Today.ToString("yyyy-MM-dd")&to=@Model.Today.ToString("yyyy-MM-dd")">Сегодня</a>
    <a class="btn btn-sm btn-outline-secondary" href="?from=@Model.WeekFrom.ToString("yyyy-MM-dd")&to=@Model.WeekTo.ToString("yyyy-MM-dd")">Неделя</a>
    <a class="btn btn-sm btn-outline-secondary" href="?from=@Model.MonthFrom.ToString("yyyy-MM-dd")&to=@Model.MonthTo.ToString("yyyy-MM-dd")">Месяц</a>
    @if (Model.FiltersRestored)
    {
        <span class="badge text-bg-light border align-self-center">Сохранённый фильтр</span>
    }
    <a class="btn btn-sm btn-link" href="?reset=1">Сбросить сохранённый</a>
</div>

@if (TempData["BulkApprovalResults"] is string bulkApprovalResults)
{
    <div class="alert alert-info" role="status">
        <strong>Результат массового утверждения.</strong>
        @if (TempData["BulkApprovalSummary"] is string bulkApprovalSummary)
        {
            <div>@bulkApprovalSummary</div>
        }
        <ul class="mb-0 mt-2">
            @foreach (var result in bulkApprovalResults.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                <li>@result</li>
            }
        </ul>
    </div>
}

<div class="row g-3">
    @foreach (var dept in Model.Departments)
    {
        var stats = Model.Stats(dept.Id);
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-header py-2 d-flex justify-content-between">
                    <strong>@dept.Name</strong>
                    <span class="badge bg-primary-subtle text-primary-emphasis">@stats.Hours.ToString("0.##") ч</span>
                </div>
                <div class="card-body py-2">
                    <div class="small">
                        На утверждении: <strong>@stats.Submitted</strong><br />
                        Утверждено: <strong>@stats.Approved</strong>
                    </div>
                </div>
                <div class="card-footer py-2 bg-transparent border-0">
                    <a class="btn btn-sm btn-outline-primary" href="/Production/Section?departmentId=@dept.Id&from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")">Открыть</a>
                </div>
            </div>
        </div>
    }
</div>

<h5 class="mt-4">Ожидают утверждения</h5>
@{
    var submitted = Model.Days.Where(d => d.Status == TimeSheetStatus.Submitted)
        .OrderBy(d => d.Date).ThenBy(d => d.Employee?.FullName).ToList();
}
@if (!submitted.Any())
{
    <div class="alert alert-success py-2">Нет табелей, ожидающих утверждения.</div>
}
else
{
    <div class="card">
        <div class="card-header py-2 d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <form method="post" asp-page-handler="BulkApprove" id="bulk-approval-form"
                  onsubmit="return confirm('Утвердить выбранные табели?');">
                <input type="hidden" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
                <button class="btn btn-sm btn-success"><i class="bi bi-check2-square"></i> Утвердить выбранные</button>
            </form>
            <form method="post" asp-page-handler="BulkApproveAll"
                  onsubmit="return confirm('Утвердить все табели на утверждении в выбранном диапазоне (@submitted.Count)?');">
                <input type="hidden" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
                <button class="btn btn-sm btn-outline-success"><i class="bi bi-check2-all"></i> Утвердить все (@submitted.Count)</button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="text-center" style="width: 3rem;">
                            <input type="checkbox" class="form-check-input" id="select-all-days" aria-label="Выбрать все табели" />
                        </th>
                        <th>Сотрудник</th><th>Подразделение</th><th>Дата</th><th class="text-end">Часов</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in submitted)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input" name="dayIds" value="@d.Id"
                                       form="bulk-approval-form" aria-label="Выбрать табель: @d.Employee?.FullName, @d.Date.ToString("dd.MM.yyyy")" />
                            </td>
                            <td>@d.Employee?.FullName</td>
                            <td>@d.Employee?.Department?.Name</td>
                            <td>@d.Date.ToString("dd.MM.yyyy")</td>
                            <td class="text-end">@d.WorkedHours.ToString("0.##")</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-primary" href="/Master/Day?employeeId=@d.EmployeeId&date=@d.Date.ToString("yyyy-MM-dd")">Открыть</a>
                                <form method="post" asp-page-handler="Approve" class="d-inline">
                                    <input type="hidden" name="dayId" value="@d.Id" />
                                    <input type="hidden" name="from" value="@Model.From.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="to" value="@Model.To.ToString("yyyy-MM-dd")" />
                                    <button class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Утвердить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('select-all-days')?.addEventListener('change', function () {
            document.querySelectorAll('input[name="dayIds"][form="bulk-approval-form"]')
                .forEach(checkbox => checkbox.checked = this.checked);
        });
    </script>
}
