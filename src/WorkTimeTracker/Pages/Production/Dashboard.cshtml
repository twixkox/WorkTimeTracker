@page
@model WorkTimeTracker.Pages.Production.DashboardModel
@{
    ViewData["Title"] = "Дашборд производства";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="mb-0">Дашборд производства</h4>
    <form method="get" class="d-flex gap-2 align-items-center">
        <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <span>—</span>
        <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <button class="btn btn-sm btn-primary">Показать</button>
    </form>
</div>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-sm btn-outline-success" href="?handler=ExportBoats&from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")">
        <i class="bi bi-file-earmark-excel"></i> Катера (Excel)
    </a>
    <a class="btn btn-sm btn-outline-success" href="?handler=ExportLoad&from=@Model.From.ToString("yyyy-MM-dd")&to=@Model.To.ToString("yyyy-MM-dd")">
        <i class="bi bi-file-earmark-excel"></i> Загрузка сотрудников (Excel)
    </a>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header py-2"><strong>Распределение времени по участкам</strong></div>
            <div class="card-body"><canvas id="deptChart" height="220"></canvas></div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header py-2"><strong>Трудозатраты по катерам (топ-15)</strong></div>
            <div class="card-body"><canvas id="boatsChart" height="220"></canvas></div>
        </div>
    </div>
    <div class="col-12">
        <div class="card">
            <div class="card-header py-2"><strong>Загрузка сотрудников (топ-15)</strong></div>
            <div class="card-body"><canvas id="loadChart" height="120"></canvas></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const deptData = @Html.Raw(Model.DeptChartJson);
        const boatsData = @Html.Raw(Model.BoatsChartJson);
        const loadData = @Html.Raw(Model.LoadChartJson);

        new Chart(document.getElementById('deptChart'), {
            type: 'bar',
            data: {
                labels: deptData.map(d => d.dept),
                datasets: [
                    { label: 'По катерам, ч', data: deptData.map(d => d.boats), backgroundColor: '#0d6efd' },
                    { label: 'Внутрицеховые, ч', data: deptData.map(d => d.inhouse), backgroundColor: '#fd7e14' }
                ]
            },
            options: { scales: { x: { stacked: true }, y: { stacked: true } } }
        });

        new Chart(document.getElementById('boatsChart'), {
            type: 'bar',
            data: {
                labels: boatsData.map(b => b.boat),
                datasets: [{ label: 'Часы', data: boatsData.map(b => b.hours), backgroundColor: '#20c997' }]
            }
        });

        new Chart(document.getElementById('loadChart'), {
            type: 'bar',
            data: {
                labels: loadData.map(l => l.name),
                datasets: [{ label: 'Отработано, ч', data: loadData.map(l => l.worked), backgroundColor: '#6f42c1' }]
            }
        });
    </script>
}
